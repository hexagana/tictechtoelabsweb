                                <span class="status-icon">✓</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Question 10 -->
                <div class="question-card">
                    <div class="question-number">QUESTION 10</div>
                    <div class="question-text">Which option is most secure for sharing a draft with one colleague?</div>
                    <div class="options">
                        <div class="option">
                            <input type="radio" id="q10a" name="q10" value="Anyone with the link – can edit">
                            <label class="option-label" for="q10a">
                                Anyone with the link – can edit
                                <span class="status-icon">✗</span>
                            </label>
                        </div>
                        <div class="option">
                            <input type="radio" id="q10b" name="q10" value="Public – anyone can view">
                            <label class="option-label" for="q10b">
                                Public – anyone can view
                                <span class="status-icon">✗</span>
                            </label>
                        </div>
                        <div class="option">
                            <input type="radio" id="q10c" name="q10" value="Specific person – view">
                            <label class="option-label" for="q10c">
                                Specific person – view
                                <span class="status-icon">✓</span>
                            </label>
                        </div>
                        <div class="option">
                            <input type="radio" id="q10d" name="q10" value="Anyone with the link – can view">
                            <label class="option-label" for="q10d">
                                Anyone with the link – can view
                                <span class="status-icon">✗</span>
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">Submit Quiz</button>
            </form>
        </div>

        <div id="resultsSection" class="results">
            <div class="results-summary">
                <div class="score-label">Your Score</div>
                <div class="score-display" id="scoreDisplay">0/10</div>
                <div class="score-message" id="scoreMessage"></div>
                
                <div class="summary-stats">
                    <div class="stat">
                        <div class="stat-value correct" id="correctCount">0</div>
                        <div class="stat-label">Correct Answers</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value incorrect" id="incorrectCount">0</div>
                        <div class="stat-label">Incorrect Answers</div>
                    </div>
                </div>
            </div>

            <div class="review-section">
                <h2 class="review-title">Answer Review</h2>
                <div id="reviewContainer"></div>
            </div>

            <button class="retry-btn" onclick="retakeQuiz()">Retake Quiz</button>
        </div>
    </div>

    <script>
        const correctAnswers = {
            q1: 'Automation and AI',
            q2: 'Learning prompt writing',
            q3: 'PARA',
            q4: 'PARA – Projects',
            q5: "Sender address doesn't match the company domain",
            q6: 'Report it to IT/security',
            q7: 'Trigger: new email → Action: save to OneDrive or Google Drive',
            q8: 'Ask AI general questions without using private data',
            q9: 'Primitive Analytics',
            q10: 'Specific person – view'
        };

        const questionTexts = {
            q1: 'Which is a current trend shaping the future of work?',
            q2: 'If your industry is adopting AI tools, which skill would help you stay relevant?',
            q3: 'Which framework has the categories Projects, Areas, Resources, Archives?',
            q4: 'You want to organise all notes for one ongoing project — which method is best?',
            q5: 'Which of these is a phishing red flag?',
            q6: 'What should you do first after spotting a phishing email?',
            q7: 'Which one is a good example of automation?',
            q8: 'Which is the safest way to use AI for a client report?',
            q9: 'Which of the Analytics below is not part of analytics functions of Big Data?',
            q10: 'Which option is most secure for sharing a draft with one colleague?'
        };

        const form = document.getElementById('quizForm');
        const submitBtn = document.getElementById('submitBtn');
        const quizSection = document.getElementById('quizSection');
        const resultsSection = document.getElementById('resultsSection');
        const progressFill = document.getElementById('progressFill');
        const progressText = document.getElementById('progressText');

        // Update progress as user answers
        const radioButtons = document.querySelectorAll('input[type="radio"]');
        radioButtons.forEach(radio => {
            radio.addEventListener('change', updateProgress);
        });

        function updateProgress() {
            let answered = 0;
            const totalQuestions = 10;
            
            for (let i = 1; i <= totalQuestions; i++) {
                const question = document.querySelector(`input[name="q${i}"]:checked`);
                if (question) answered++;
            }
            
            const percentage = (answered / totalQuestions) * 100;
            progressFill.style.width = percentage + '%';
            progressText.textContent = `Question ${answered} of ${totalQuestions}`;
        }

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Check if all questions are answered
            let allAnswered = true;
            for (let i = 1; i <= 10; i++) {
                const question = document.querySelector(`input[name="q${i}"]:checked`);
                if (!question) {
                    allAnswered = false;
                    break;
                }
            }

            if (!allAnswered) {
                alert('Please answer all questions before submitting.');
                return;
            }

            // Calculate score and show results
            let score = 0;
            const formData = new FormData(form);
            const userAnswers = {};

            for (let i = 1; i <= 10; i++) {
                const userAnswer = formData.get(`q${i}`);
                userAnswers[`q${i}`] = userAnswer;
                const correctAnswer = correctAnswers[`q${i}`];
                const questionCard = document.querySelectorAll('.question-card')[i - 1];
                const options = questionCard.querySelectorAll('.option-label');

                options.forEach(option => {
                    const input = option.previousElementSibling;
                    const value = input.value;

                    if (value === correctAnswer) {
                        option.classList.add('correct');
                    } else if (value === userAnswer && value !== correctAnswer) {
                        option.classList.add('incorrect');
                    }
                });

                if (userAnswer === correctAnswer) {
                    score++;
                }
            }

            // Disable form
            const allInputs = form.querySelectorAll('input');
            allInputs.forEach(input => input.disabled = true);
            submitBtn.disabled = true;
            submitBtn.textContent = 'Quiz Completed';

            // Show results after a brief delay
            setTimeout(() => {
                displayResults(score, userAnswers);
            }, 800);
        });

        function displayResults(score, userAnswers) {
            const percentage = (score / 10) * 100;
            let message = '';

            if (percentage >= 90) {
                message = 'Outstanding! You have excellent digital skills! 🌟';
            } else if (percentage >= 70) {
                message = 'Great job! You have a strong understanding! 💪';
            } else if (percentage >= 50) {
                message = 'Good effort! Keep learning and improving! 📚';
            } else {
                message = 'Keep practicing! Review the materials and try again! 🎯';
            }

            document.getElementById('scoreDisplay').textContent = `${score}/10`;
            document.getElementById('scoreMessage').textContent = message;
            document.getElementById('correctCount').textContent = score;
            document.getElementById('incorrectCount').textContent = (10 - score);

            // Generate review section
            generateReview(userAnswers);

            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Show results section
            setTimeout(() => {
                quizSection.style.display = 'none';
                resultsSection.classList.add('active');
            }, 300);
        }

        function generateReview(userAnswers) {
            const reviewContainer = document.getElementById('reviewContainer');
            reviewContainer.innerHTML = '';

            for (let i = 1; i <= 10; i++) {
                const questionKey = `q${i}`;
                const userAnswer = userAnswers[questionKey];
                const correctAnswer = correctAnswers[questionKey];
                const questionText = questionTexts[questionKey];
                const isCorrect = userAnswer === correctAnswer;

                const reviewItem = document.createElement('div');
                reviewItem.className = `review-item ${isCorrect ? 'correct-answer' : 'wrong-answer'}`;

                const statusIcon = isCorrect ? '✓' : '✗';
                const statusText = isCorrect ? 'Correct' : 'Incorrect';
                const statusClass = isCorrect ? 'correct' : 'incorrect';

                let answerHTML = '';
                
                if (isCorrect) {
                    // Show only the correct answer
                    answerHTML = `
                        <div class="review-answer your-answer correct">
                            <span class="review-answer-label correct">Your Answer:</span>
                            <span>${userAnswer}</span>
                        </div>
                    `;
                } else {
                    // Show both wrong answer and correct answer
                    answerHTML = `
                        <div class="review-answer your-answer incorrect">
                            <span class="review-answer-label incorrect">Your Answer:</span>
                            <span>${userAnswer}</span>
                        </div>
                        <div class="review-answer correct-answer-display">
                            <span class="review-answer-label correct">Correct Answer:</span>
                            <span>${correctAnswer}</span>
                        </div>
                    `;
                }

                reviewItem.innerHTML = `
                    <div class="review-header">
                        <div class="review-question-number">QUESTION ${String(i).padStart(2, '0')}</div>
                        <div class="review-status ${statusClass}">
                            <span>${statusText}</span>
                            <span class="review-status-icon">${statusIcon}</span>
                        </div>
                    </div>
                    <div class="review-question-text">${questionText}</div>
                    ${answerHTML}
                `;

                reviewContainer.appendChild(reviewItem);
            }
        }

        function retakeQuiz() {
            // Reset form
            form.reset();
            
            // Remove all status classes
            document.querySelectorAll('.option-label').forEach(label => {
                label.classList.remove('correct', 'incorrect');
            });

            // Enable all inputs
            const allInputs = form.querySelectorAll('input');
            allInputs.forEach(input => input.disabled = false);
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Quiz';

            // Reset progress
            progressFill.style.width = '0%';
            progressText.textContent = 'Question 0 of 10';

            // Clear review
            document.getElementById('reviewContainer').innerHTML = '';

            // Hide results, show quiz
            resultsSection.classList.remove('active');
            quizSection.style.display = 'block';

            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
